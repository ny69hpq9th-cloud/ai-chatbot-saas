# Application
APP_NAME="AI Chatbot Platform"
APP_URL=https://yourdomain.com
APP_ENV=production
APP_DEBUG=false
APP_KEY=change_this_to_a_random_64_char_string

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_chatbot
DB_USER=root
DB_PASS=

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — use pk_test_ / sk_test_ for development, pk_live_ / sk_live_ for production
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in the Stripe Dashboard (monthly recurring)
# Starter $9/mo | Pro $29/mo | Business $79/mo | Agency $149/mo | Enterprise custom
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Mail
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME="AI Chatbot Platform"
