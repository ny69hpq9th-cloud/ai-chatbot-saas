Options -Indexes

# Block direct access to sensitive directories
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Protect includes, database, cron
  RewriteRule ^(includes|database|cron|logs)/ - [F,L]

  # Block .env
  RewriteRule ^\.env$ - [F,L]

  # Route everything through public_html
  RewriteCond %{REQUEST_URI} !^/public_html/
  RewriteRule ^(.*)$ /public_html/$1 [L]
</IfModule>
